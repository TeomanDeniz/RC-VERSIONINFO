1 VERSIONINFO
FILEVERSION <MAJOR>,<MINOR>,<PATCH>,<BUILD>
PRODUCTVERSION <MAJOR>,<MINOR>,<PATCH>,<BUILD>
FILEOS 0x40004
FILETYPE 0x1
{
BLOCK "StringFileInfo"
{
	BLOCK "040904B0"
	{
		VALUE "CompanyName", "<COMPANY_NAME>"
		VALUE "LegalTrademarks", "<COMPANY_NAME>"
		VALUE "Developer", "<DEVELOPER_NAME>"
		VALUE "Signer", "<COMPANY_NAME>"
		VALUE "OriginalFilename", "<FILE_NAME>.exe"
		VALUE "Comments", "<COMMENTS_EN>"
		VALUE "FileDescription", "<DESCRIPTION_EN>"
		VALUE "InternalName", "<FILE_NAME>"
		VALUE "ProductName", "<PRODUCT_NAME>"
		VALUE "LegalCopyright", "© <YEAR> <DEVELOPER_NAME>"
		VALUE "CopyrightOwner", "<COMPANY_NAME>"
		VALUE "CopyrightNotice", "© <YEAR> <COMPANY_NAME>"
		VALUE "Build", "<BUILD>"
		VALUE "BuildDate", "<BUILD_DATE>"
		VALUE "FileVersion", "<VERSION>"
		VALUE "ProductVersion", "<VERSION>"
		VALUE "Debugger", "0"
		VALUE "SupportedOS", "<SUPPORTED_OS>"
		VALUE "URL", "<URL>"
		VALUE "SupportEmail", "<SUPPORT_EMAIL>"
	}

	BLOCK "041F04B0"
	{
		VALUE "CompanyName", "<COMPANY_NAME>"
		VALUE "LegalTrademarks", "<COMPANY_NAME>"
		VALUE "Developer", "<DEVELOPER_NAME>"
		VALUE "Signer", "<COMPANY_NAME>"
		VALUE "OriginalFilename", "<FILE_NAME>.exe"
		VALUE "Comments", "<COMMENTS_TR>"
		VALUE "FileDescription", "<DESCRIPTION_TR>"
		VALUE "InternalName", "<FILE_NAME>"
		VALUE "ProductName", "<PRODUCT_NAME>"
		VALUE "LegalCopyright", "© <YEAR> <DEVELOPER_NAME>"
		VALUE "CopyrightOwner", "<COMPANY_NAME>"
		VALUE "CopyrightNotice", "© <YEAR> <COMPANY_NAME>"
		VALUE "Build", "<BUILD>"
		VALUE "BuildDate", "<BUILD_DATE>"
		VALUE "FileVersion", "<VERSION>"
		VALUE "ProductVersion", "<VERSION>"
		VALUE "Debugger", "0"
		VALUE "SupportedOS", "<SUPPORTED_OS>"
		VALUE "URL", "<URL>"
		VALUE "SupportEmail", "<SUPPORT_EMAIL>"
	}
}

BLOCK "VarFileInfo"
{
	VALUE "Translation", 0x0409, 0x04B0, 0x041F, 0x04B0
}
}
